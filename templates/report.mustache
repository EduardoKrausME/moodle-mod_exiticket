{{!
    @template mod_exiticket/report

    Example context (json):
    {
    }
}}
<div class="row g-3 mb-4 mod-exiticket-summary">
    <div class="col-sm-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">{{#str}}submitted, mod_exiticket{{/str}}</div>
                <div class="display-6">{{responsecount}}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">{{#str}}pending, mod_exiticket{{/str}}</div>
                <div class="display-6">{{pendingcount}}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">{{#str}}responserate, mod_exiticket{{/str}}</div>
                <div class="display-6">{{rate}}%</div>
                <div class="small text-muted">{{responsecount}} / {{eligiblecount}}</div>
            </div>
        </div>
    </div>
</div>

{{^hasresponses}}
<div class="alert alert-info">{{#str}}noresponses, mod_exiticket{{/str}}</div>
{{/hasresponses}}

{{#questions}}
<section class="mb-5">
    <h3 class="h4 mb-3">{{question}}</h3>
    <div class="list-group">
        {{#responses}}
        <div class="list-group-item">
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                <a href="{{{profileurl}}}"><strong>{{fullname}}</strong></a>
                <span class="small text-muted">{{time}}</span>
            </div>
            <div>{{{answer}}}</div>
        </div>
        {{/responses}}
        {{^responses}}
        <div class="list-group-item text-muted">{{#str}}noanswersforthisquestion, mod_exiticket{{/str}}</div>
        {{/responses}}
    </div>
</section>
{{/questions}}
