{{!
    @template mod_exiticket/student_view

    Example context (json):
    {
    }
}}
{{#hasintro}}
<div class="mod-exiticket-intro mb-4">{{{intro}}}</div>
{{/hasintro}}

<div class="d-flex flex-wrap gap-2 mb-4">
    {{#canviewreport}}
        <a class="btn btn-secondary" href="{{{reporturl}}}">{{#str}}viewreport, mod_exiticket{{/str}}</a>
    {{/canviewreport}}
    {{#closelabel}}
        <span class="badge bg-light text-dark align-self-center">{{closelabel}}</span>
    {{/closelabel}}
</div>

{{#hasresponse}}
<div class="alert alert-success" role="status">
    {{#str}}alreadyresponded, mod_exiticket{{/str}}
    {{#cannotedit}}{{#str}}responsecannotbeedited, mod_exiticket{{/str}}{{/cannotedit}}
</div>

<div class="mod-exiticket-own-response mb-4">
    {{#questions}}
    <div class="card mb-3">
        <div class="card-body">
            <h3 class="h5">{{question}}</h3>
            <div>{{{answer}}}</div>
        </div>
    </div>
    {{/questions}}
</div>
{{/hasresponse}}

{{#closed}}
<div class="alert alert-secondary" role="status">{{#str}}activityclosed, mod_exiticket{{/str}}</div>
{{/closed}}
